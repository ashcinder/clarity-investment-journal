{
  "name": "clarity-investment-journal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node backend/scripts/local.mjs --dev",
    "build": "npm run build --workspace frontend",
    "start": "node backend/scripts/local.mjs --start",
    "clean": "node backend/scripts/clean.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test backend/tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.json",
    "local": "node backend/scripts/local.mjs",
    "local:build": "npm run build",
    "local:start": "npm run start",
    "local:dev": "npm run dev",
    "test:standalone": "node backend/tests/standalone.test.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:site": "vinext dev",
    "build:site": "vinext build",
    "start:site": "wrangler dev --config dist/server/wrangler.json"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "drizzle-kit": "0.31.10"
  },
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ]
}
